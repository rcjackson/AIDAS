    affiliation: Argonne National Laboratory
version: 0.6.0
license: BSD-3-Clause
repository-code: "https://github.com/rcjackson/AIDAS"
url: "https://rcjackson.github.io/AIDAS/"
keywords:
  - adaptive sampling
  - weather radar
  - Doppler lidar
  - NEXRAD
  - lake breeze
  - deep learning
  - instrument tasking
